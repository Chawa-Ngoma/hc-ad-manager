Options -Indexes
AddType application/manifest+json .webmanifest

<FilesMatch "^(lib\.php|mailer\.php)$|\.(sqlite|key|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
